# Normalize text files to LF so the project builds cleanly on macOS
* text=auto eol=lf

# Binary asset trees: never convert line endings
Data/** -text
Il2CppOutputProject/IL2CPP/build/** -text

# Binary file types
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.mp4 binary
*.mov binary
*.dat binary
*.dll binary
*.dylib binary
*.so binary
*.assets binary
*.resS binary
*.resource binary
*.unity3d binary
*.ipa binary
*.aar binary
*.jar binary

# Git LFS: static libraries exceed GitHub's 100 MB per-file limit
*.a filter=lfs diff=lfs merge=lfs -text
